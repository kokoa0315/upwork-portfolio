{
  "name": "sorted",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --port 4360",
    "build": "next build",
    "start": "next start --port 4360",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:reset": "node ../../devstack/cli.mjs reset",
    "stack": "node ../../devstack/cli.mjs up",
