# Local stack for Cobalt (apps/rescue). Shares the Postgres cluster with the other apps; its own database.
APP_DB=rescue
PG_PORT=57240
POSTGREST_PORT=58270
GATEWAY_PORT=4371
JWT_SECRET=local-only-rescue-jwt-secret-0123456789abcdef
# 100-second access tokens, so the "signed out after the access token expires" bug reproduces in about two minutes
# instead of an hour. It must stay above 90 s: supabase-js starts refreshing 90 s before expiry, and with a shorter
# lifetime every freshly refreshed token would already be due again.
JWT_EXPIRY=100
